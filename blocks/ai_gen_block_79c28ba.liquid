{% doc %}
  @prompt
    Create a "Before & After Results" section for the product page that displays 4 before/after images in a grid layout (2 columns on mobile). Add a title in Arabic "نتائج حقيقية - قبل وبعد" above the images. The images should be: https://cdn.shopify.com/s/files/1/0746/5133/6893/files/1000846442.jpg, https://cdn.shopify.com/s/files/1/0746/5133/6893/files/1000846444.jpg, https://cdn.shopify.com/s/files/1/0746/5133/6893/files/1000846441.png, https://cdn.shopify.com/s/files/1/0746/5133/6893/files/1000846443_1.png. Make it look clean and professional on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-before-after-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 16px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-before-after-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-before-after-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 600;
  }

  .ai-before-after-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-before-after-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.image_background }};
  }

  .ai-before-after-item-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-before-after-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top }}px 32px {{ block.settings.section_padding_bottom }}px;
    }

    .ai-before-after-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    }

    .ai-before-after-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 1.2 }}px;
    }
  }
{% endstyle %}

<div class="ai-before-after-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-before-after-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-before-after-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-before-after-grid-{{ ai_gen_id }}">
      {% if block.settings.image_1 != blank %}
        <div class="ai-before-after-item-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image_1 }}"
            alt="{{ block.settings.image_1_alt | escape }}"
            loading="lazy"
            width="800"
            height="800"
          >
        </div>
      {% endif %}

      {% if block.settings.image_2 != blank %}
        <div class="ai-before-after-item-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image_2 }}"
            alt="{{ block.settings.image_2_alt | escape }}"
            loading="lazy"
            width="800"
            height="800"
          >
        </div>
      {% endif %}

      {% if block.settings.image_3 != blank %}
        <div class="ai-before-after-item-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image_3 }}"
            alt="{{ block.settings.image_3_alt | escape }}"
            loading="lazy"
            width="800"
            height="800"
          >
        </div>
      {% endif %}

      {% if block.settings.image_4 != blank %}
        <div class="ai-before-after-item-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image_4 }}"
            alt="{{ block.settings.image_4_alt | escape }}"
            loading="lazy"
            width="800"
            height="800"
          >
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before & After results",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "نتائج حقيقية - قبل وبعد"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
