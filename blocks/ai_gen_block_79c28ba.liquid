    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "text",
      "id": "image_2",
      "label": "Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0746/5133/6893/files/1000846444.jpg"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image alt text",
      "default": "Before and after result 2"
    },
    {
      "type": "header",
      "content": "Image 3"
    },
    {
      "type": "text",
      "id": "image_3",
      "label": "Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0746/5133/6893/files/1000846441.png"
    },
    {
      "type": "text",
      "id": "image_3_alt",
      "label": "Image alt text",
      "default": "Before and after result 3"
    },
    {
      "type": "header",
      "content": "Image 4"
    },
    {
      "type": "text",
      "id": "image_4",
      "label": "Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0746/5133/6893/files/1000846443_1.png"
