{% doc %}
  @prompt
    Create a product price display block that shows only the current selling price (no compare-at price, no strikethrough). Use CSS with `order` property to force this price block to appear visually above the buy buttons on the product page. The buy buttons have the class `product-form__buttons`. Use flexbox ordering so this price block always renders before the buy button regardless of its position in the DOM. Display the price in a large bold font using Liquid: {{ product.selected_or_first_available_variant.price | money }}.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-price-display-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    order: {{ block.settings.display_order }};
  }

  .ai-price-display__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    color: {{ block.settings.price_color }};
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-price-display__price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-price-display-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-price-display__price-{{ ai_gen_id }}">
    {{ product.selected_or_first_available_variant.price | money }}
  </div>
</div>

{% schema %}
{
  "name": "Price display",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Price style"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Price weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#f89db5"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Display order"
    },
    {
      "type": "paragraph",
      "content": "Control where this price appears relative to buy buttons. Lower numbers appear first."
    },
    {
      "type": "range",
      "id": "display_order",
      "label": "Order position",
      "min": -10,
      "max": 10,
      "step": 1,
      "default": -1
    }
  ],
  "presets": [
    {
      "name": "Price display"
    }
  ]
}
{% endschema %}
