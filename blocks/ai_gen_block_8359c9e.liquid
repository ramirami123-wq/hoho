{% doc %}
  @prompt
    Create a prominent price display block for the product page that shows ONLY the current sale price in a large bold font. Do NOT show the compare-at price or original price or any strikethrough price. Only display the selling price.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-price-display-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-price-display__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-price-display__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    color: {{ block.settings.price_color }};
    margin: 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-price-display__price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.8);
    }
  }
{% endstyle %}

<price-display-{{ ai_gen_id }}
  class="ai-price-display-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-price-display__container-{{ ai_gen_id }}">
    {% if product %}
      <div class="ai-price-display__price-{{ ai_gen_id }}">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>
    {% else %}
      <div class="ai-price-display__price-{{ ai_gen_id }}">
        $99.00
      </div>
    {% endif %}
  </div>
</price-display-{{ ai_gen_id }}>

<script>
  (function() {
    class PriceDisplay{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupVariantListener();
      }

      setupVariantListener() {
        const productForm = document.querySelector('product-form');
        if (!productForm) return;

        productForm.addEventListener('variant-change', (event) => {
          const variant = event.detail.variant;
          if (variant) {
            this.updatePrice(variant.price);
          }
        });
      }

      updatePrice(price) {
        const priceElement = this.querySelector('.ai-price-display__price-{{ ai_gen_id }}');
        if (priceElement) {
          priceElement.textContent = this.formatMoney(price);
        }
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return new Intl.NumberFormat('{{ localization.language.iso_code }}', {
          style: 'currency',
          currency: '{{ cart.currency.iso_code }}'
        }).format(amount);
      }
    }

    customElements.define('price-display-{{ ai_gen_id }}', PriceDisplay{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Prominent price display",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Price style"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Price weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#f89db5"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Container style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Prominent price display"
    }
  ]
}
{% endschema %}
