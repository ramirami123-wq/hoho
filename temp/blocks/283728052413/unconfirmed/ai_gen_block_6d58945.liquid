{% doc %}
  @prompt
    Create a price display block for the product page that shows ONLY the current selling price using Liquid product.selected_or_first_available_variant.price. Display it in a large bold font. Do NOT show compare-at price or any strikethrough price.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-price-display-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-price-display__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    color: {{ block.settings.price_color }};
    margin: 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-price-display__price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.8);
    }
  }
{% endstyle %}

<price-display-{{ ai_gen_id }}
  class="ai-price-display-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-price-display__price-{{ ai_gen_id }}">
    {{ product.selected_or_first_available_variant.price | money }}
  </div>
</price-display-{{ ai_gen_id }}>

<script>
  (function() {
    class PriceDisplay{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('price-display-{{ ai_gen_id }}', PriceDisplay{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Price display",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Price style"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Price weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#f89db5"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Price display"
    }
  ]
}
{% endschema %}
