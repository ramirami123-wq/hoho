{% doc %}
  @prompt
    Create a product price display block that shows only the current selling price (no compare-at price, no strikethrough). Use CSS with `order` property to force this price block to appear visually above the buy buttons on the product page. The buy buttons have the class `product-form__buttons`. Use flexbox ordering so this price block always renders before the buy button regardless of its position in the DOM. Display the price in a large bold font using Liquid: {{ product.selected_or_first_available_variant.price | money }}.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-price-display-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    order: -1;
    margin-bottom: {{ block.settings.spacing_below }}px;
  }

  .ai-price-display__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    color: {{ block.settings.price_color }};
    line-height: 1.2;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-price-display-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-price-display__price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.85);
    }
  }
{% endstyle %}

<price-display-{{ ai_gen_id }}
  class="ai-price-display-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-price-display__price-{{ ai_gen_id }}">
    {{ product.selected_or_first_available_variant.price | money }}
  </div>
</price-display-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Product price display",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Price style"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Price weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#f89db5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "spacing_below",
      "label": "Spacing below",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product price display"
    }
  ]
}
{% endschema %}
