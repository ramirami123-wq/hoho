{% doc %}
  @prompt
    Create a product price display block that shows only the current selling price (no compare-at price, no strikethrough). Use CSS with `order` property to force this price block to appear visually above the buy buttons on the product page. The buy buttons have the class `product-form__buttons`. Use flexbox ordering so this price block always renders before the buy button regardless of its position in the DOM. Display the price in a large bold font using Liquid: {{ product.selected_or_first_available_variant.price | money }}.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-price-display-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    order: {{ block.settings.display_order }};
  }

  .ai-price-display__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-price-display__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-price-display__price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.8);
    }
  }
{% endstyle %}

<price-display-{{ ai_gen_id }}
  class="ai-price-display-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-price-display__container-{{ ai_gen_id }}">
    <div class="ai-price-display__price-{{ ai_gen_id }}">
      {{ product.selected_or_first_available_variant.price | money }}
    </div>
  </div>
</price-display-{{ ai_gen_id }}>

<script>
  (function() {
    class PriceDisplay{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.updatePriceOnVariantChange();
      }

      updatePriceOnVariantChange() {
        const productForm = document.querySelector('product-form');
        if (!productForm) return;

        productForm.addEventListener('variant-change', (event) => {
          const variant = event.detail.variant;
          if (variant) {
            const priceElement = this.querySelector('.ai-price-display__price-{{ ai_gen_id }}');
            if (priceElement) {
              fetch(`${window.location.pathname}?variant=${variant.id}&section_id=${this.closest('.shopify-section').dataset.sectionId}`)
                .then(response => response.text())
                .then(text => {
                  const html = new DOMParser().parseFromString(text, 'text/html');
                  const newPrice = html.querySelector('.ai-price-display__price-{{ ai_gen_id }}');
                  if (newPrice) {
                    priceElement.innerHTML = newPrice.innerHTML;
                  }
                });
            }
          }
        });
      }
    }

    customElements.define('price-display-{{ ai_gen_id }}', PriceDisplay{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product price display",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "display_order",
      "label": "Display order",
      "min": -10,
      "max": 10,
      "step": 1,
      "default": -1,
      "info": "Negative values appear before buy buttons. Use -1 to display immediately before buttons."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Price style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f89db5"
    },
    {
      "type": "header",
      "content": "Container style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product price display"
    }
  ]
}
{% endschema %}
