{% doc %}
  @prompt
    Create a trust badges section that appears below the Add to Cart button on the product page. It should display 4 icons with Arabic text: ✅ شحن مجاني (Free Shipping), 🔒 دفع آمن (Secure Payment), 💰 ضمان استرداد 30 يوم (30-Day Money Back Guarantee), ⭐ جودة مضمونة (Guaranteed Quality). The badges should be displayed in a horizontal row, clean and minimal design that matches a beauty/skincare store.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-trust-badges__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-trust-badge-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.icon_text_gap }}px;
    padding: {{ block.settings.badge_padding }}px;
    background-color: {{ block.settings.badge_background }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-trust-badge__icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    line-height: 1;
  }

  .ai-trust-badge__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.3;
    font-weight: {{ block.settings.text_weight }};
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-trust-badge__icon-{{ ai_gen_id }} {
      font-size: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-trust-badge__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badges__container-{{ ai_gen_id }}">
    {% if block.settings.badge_1_enabled %}
      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <div class="ai-trust-badge__icon-{{ ai_gen_id }}">{{ block.settings.badge_1_icon }}</div>
        <div class="ai-trust-badge__text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</div>
      </div>
    {% endif %}

    {% if block.settings.badge_2_enabled %}
      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <div class="ai-trust-badge__icon-{{ ai_gen_id }}">{{ block.settings.badge_2_icon }}</div>
        <div class="ai-trust-badge__text-{{ ai_gen_id }}">{{ block.settings.badge_2_text }}</div>
      </div>
    {% endif %}

    {% if block.settings.badge_3_enabled %}
      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <div class="ai-trust-badge__icon-{{ ai_gen_id }}">{{ block.settings.badge_3_icon }}</div>
        <div class="ai-trust-badge__text-{{ ai_gen_id }}">{{ block.settings.badge_3_text }}</div>
      </div>
    {% endif %}

    {% if block.settings.badge_4_enabled %}
      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <div class="ai-trust-badge__icon-{{ ai_gen_id }}">{{ block.settings.badge_4_icon }}</div>
        <div class="ai-trust-badge__text-{{ ai_gen_id }}">{{ block.settings.badge_4_text }}</div>
      </div>
    {% endif %}
  </div>
</div>

