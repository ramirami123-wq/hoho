    "faq_7rE8am": {
      "type": "faq",
      "blocks": {
        "question_M7TqYW": {
          "type": "question",
          "settings": {
            "title": "How do I charge the device?",
            "text": "<p>The device charges via the included USB cable. Full charging time is approximately 1-2 hours, and it works for several sessions on a single charge.</p>"
          }
        },
        "question_yqHqK6": {
          "type": "question",
          "settings": {
            "title": "How do I use the ALMAS device?",
            "text": "<p>Cleanse your face and neck thoroughly, then apply serum or moisturizing cream. Turn on the device and select the appropriate intensity level, then massage gently in upward motions for 5-10 minutes daily for best results.</p>"
          }
        },
        "question_7XFnnm": {
          "type": "question",
          "settings": {
            "title": "Can I use serum or cream with the device?",
            "text": "<p>Yes, it's highly recommended! The device enhances the absorption of serums and creams more deeply and quickly thanks to its vibration and microcurrent technology. Use hyaluronic acid serum or any moisturizing cream you prefer.</p>"
          }
        },
        "question_QTiLt3": {
          "type": "question",
          "settings": {
            "title": "Is the device safe for daily use?",
            "text": "<p>Yes, the device is designed for safe daily use. It has 3 intensity levels — start with the first level if this is your first experience with beauty devices.</p>"
          }
        },
        "question_HCUMMj": {
          "type": "question",
          "settings": {
            "title": "When will I see results?",
            "text": "<p>You'll notice a difference in skin radiance from the first week, while full results in tightening and sculpting typically appear after 4-6 weeks of regular use.</p>"
          }
        },
        "question_P7AbQB": {
          "type": "question",
          "settings": {
            "title": "Is it suitable for all skin types?",
            "text": "<p>Yes, the device is suitable for all skin types. However, if you have very sensitive skin or certain skin conditions, it's recommended to consult a dermatologist before use.</p>"
          }
        }
      },
